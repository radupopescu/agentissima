# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Credentials for the optional frontier reference run (§8)
.env

# Per-run fixture copies (§4.6). Inside the repo so the tool container can
# bind-mount them; swept by harness/paths.py.
.runs/

# macOS
.DS_Store

# pi's own state in its isolated config directory (harness/driver_pi.py) --
# only models.json and pi-permissions.jsonc are authored and tracked.
setup/pi_config/*
!setup/pi_config/models.json
!setup/pi_config/pi-permissions.jsonc

# Deliberately NOT ignored:
#
#   fixtures/workspace/  fixtures/testrepo/  fixtures/expected/
#     These are generated, but §6 requires them committed and version-pinned.
#     Results are only comparable against a known fixture revision, and §3
#     records `fixture_git_sha` per session. Regenerating them bumps
#     `task_set_version` (§11) — which is exactly the signal a diff should show.
#
#   results/
#     The raw JSONL is the record; §10 regenerates every report from it and
#     forbids hand-editing. Revisit only if run transcripts grow unwieldy, and
#     ignore the transcripts specifically rather than the whole tree.
